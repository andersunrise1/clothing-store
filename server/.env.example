PORT=4000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=changeme
# Max upload size in MB, applied to every admin upload (product/brand
# photos, skate videos). Raise this if a real video gets rejected as "too
# large" — default covers a few minutes of decent-quality video.
MAX_UPLOAD_MB=200

# Where the frontend/backend are reachable — used to build the Mercado
# Pago checkout's back_urls and webhook notification_url. In production,
# FRONTEND_URL must be a real https:// URL (auto_return is only sent when
# it is; the real Mercado Pago API otherwise rejects preference creation).
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# Real checkout (Mercado Pago Checkout Pro). Leave both blank on a dev
# machine with no real account yet — every payment route 503s cleanly
# until MERCADOPAGO_ACCESS_TOKEN is set, and the webhook always rejects
# (401) with no MERCADOPAGO_WEBHOOK_SECRET, rather than trusting an
# unsigned notification. Get both from a real Mercado Pago application
# ("Suas integrações" → Credenciais + Webhooks in their dashboard).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
